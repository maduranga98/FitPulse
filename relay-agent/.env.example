# Firestore gym document ID this relay serves (required)
GYM_ID=

# Path to the Firebase service account JSON key (required)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Fallback device credentials, used when the device doc in
# gyms/{gymId}/devices has no username/password fields
DEVICE_USERNAME=admin
DEVICE_PASSWORD=

# Optional tuning
LOG_FILE=./relay-agent.log
MAX_ATTEMPTS=3
RETRY_BASE_MS=5000
